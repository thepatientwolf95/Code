# ---------- Mode ----------
# paper = simulation (aucun argent réel). live = vrais achats avec ton wallet.
MODE=paper

# ---------- Mise ----------
BET_EUR=5
# Garde-fous
MAX_OPEN_POSITIONS=5
MAX_BUYS_PER_HOUR=6
DAILY_BUDGET_EUR=30

# ---------- Détection "susceptible de décoller" ----------
# Durée d'observation d'un nouveau token avant décision (secondes)
WATCH_SECONDS=45
# Score minimum (0-100) pour acheter
MIN_SCORE=70
MIN_UNIQUE_BUYERS=12
MIN_BUY_SELL_RATIO=1.5
# Fourchette de market cap (en SOL) à la fin de l'observation
MIN_MCAP_SOL=40
MAX_MCAP_SOL=150
# Achat initial max du créateur (SOL) : au-delà, risque de dump
MAX_DEV_BUY_SOL=3
# Part max du volume d'achat venant d'un seul wallet
MAX_TOP_BUYER_SHARE=0.4
# Nombre max de tokens observés en parallèle
MAX_WATCHED=150

# ---------- Sorties ----------
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=40
MAX_HOLD_MINUTES=30
SELL_ON_MIGRATION=true

# ---------- Notifications ----------
# Telegram : crée un bot avec @BotFather, récupère ton chat id avec @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ou ntfy : choisis un nom de topic secret et abonne-toi dans l'app ntfy
NTFY_TOPIC=
# true = une notification pour CHAQUE token migré ; false = seulement tes positions
NOTIFY_ALL_MIGRATIONS=true

# ---------- Mode live uniquement ----------
# Clé privée (base58) d'un wallet DÉDIÉ, avec peu de fonds. Ne jamais la partager.
WALLET_PRIVATE_KEY=
RPC_URL=https://api.mainnet-beta.solana.com
SLIPPAGE_PCT=15
PRIORITY_FEE_SOL=0.0005

# Cours SOL/EUR de secours si l'API de prix est injoignable
SOL_EUR_FALLBACK=150
